// targetDatabase is injected by the V2 migration runner.
db = database(targetDatabase)

if (!existsTable(targetDatabase, `split_definition)) {
    splitDefinition = table(1:0,
        `split_id`fold_id`split_role`start_date`end_date`purge_trading_days`locked`rules_hash`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, SYMBOL, SYMBOL, DATE, DATE, INT, BOOL, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=splitDefinition, tableName=`split_definition,
        partitionColumns=`created_at, sortColumns=`split_id`fold_id`split_role`created_at)
}

if (!existsTable(targetDatabase, `dataset_manifest)) {
    datasetManifest = table(1:0,
        `dataset_id`fold_id`manifest_json`artifact_uri`row_count`manifest_hash`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, SYMBOL, STRING, STRING, LONG, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=datasetManifest, tableName=`dataset_manifest,
        partitionColumns=`created_at, sortColumns=`dataset_id`created_at)
}

if (!existsTable(targetDatabase, `experiment_run)) {
    experimentRun = table(1:0,
        `experiment_id`model_family`model_config_hash`dataset_id`seed`status`artifact_uri`started_at`finished_at`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, SYMBOL, STRING, STRING, LONG, SYMBOL, STRING, TIMESTAMP, TIMESTAMP, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=experimentRun, tableName=`experiment_run,
        partitionColumns=`started_at, sortColumns=`experiment_id`started_at)
}

if (!existsTable(targetDatabase, `metric_daily)) {
    metricDaily = table(1:0,
        `experiment_id`fold_id`signal_date`metric_name`metric_value`sample_count`valid`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, SYMBOL, DATE, SYMBOL, DOUBLE, INT, BOOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=metricDaily, tableName=`metric_daily,
        partitionColumns=`signal_date, sortColumns=`experiment_id`fold_id`metric_name`signal_date)
}

if (!existsTable(targetDatabase, `metric_summary)) {
    metricSummary = table(1:0,
        `experiment_id`fold_id`metric_scope`metric_name`metric_value`status`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, SYMBOL, SYMBOL, SYMBOL, DOUBLE, SYMBOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=metricSummary, tableName=`metric_summary,
        partitionColumns=`created_at, sortColumns=`experiment_id`fold_id`metric_scope`metric_name`created_at)
}

if (!existsTable(targetDatabase, `prediction_daily)) {
    predictionDaily = table(1:0,
        `model_id`model_version`signal_date`ts_code`raw_score`score`rank`percentile_rank`universe_id`universe_version`inference_manifest_id`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, INT, DATE, SYMBOL, DOUBLE, DOUBLE, INT, DOUBLE, SYMBOL, INT, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=predictionDaily, tableName=`prediction_daily,
        partitionColumns=`signal_date, sortColumns=`model_id`model_version`ts_code`signal_date)
}

if (!existsTable(targetDatabase, `model_registry)) {
    modelRegistry = table(1:0,
        `model_id`model_version`model_family`status`artifact_uri`artifact_hash`evidence_json`previous_status`transitioned_at`transitioned_by`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, INT, SYMBOL, SYMBOL, STRING, STRING, STRING, SYMBOL, TIMESTAMP, SYMBOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=modelRegistry, tableName=`model_registry,
        partitionColumns=`transitioned_at, sortColumns=`model_id`model_version`transitioned_at)
}

if (!existsTable(targetDatabase, `active_model_pointer)) {
    activeModelPointer = table(1:0,
        `consumer_id`environment`model_id`model_version`pointer_version`effective_at`previous_model_id`previous_model_version`run_id`data_version`created_at`source_watermark_id`record_hash,
        [SYMBOL, SYMBOL, STRING, INT, LONG, TIMESTAMP, STRING, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=activeModelPointer, tableName=`active_model_pointer,
        partitionColumns=`effective_at, sortColumns=`consumer_id`environment`pointer_version`effective_at)
}

if (!existsTable(targetDatabase, `locked_test_audit)) {
    lockedTestAudit = table(1:0,
        `audit_id`model_id`model_version`action`preregistration_hash`capability_hash`actor`approver`consumed`event_at`details_json`run_id`data_version`created_at`source_watermark_id`record_hash,
        [UUID, STRING, INT, SYMBOL, STRING, STRING, SYMBOL, SYMBOL, BOOL, TIMESTAMP, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=lockedTestAudit, tableName=`locked_test_audit,
        partitionColumns=`event_at, sortColumns=`model_id`model_version`event_at)
}
