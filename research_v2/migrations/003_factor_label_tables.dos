// targetDatabase is injected by the V2 migration runner.
db = database(targetDatabase)

if (!existsTable(targetDatabase, `factor_registry)) {
    factorRegistry = table(1:0,
        `factor_id`factor_version`display_name`factor_type`frequency`expected_direction`source_database`source_table`source_value_column`availability_policy`max_staleness_calendar_days`unit`definition_hash`owner`status`run_id`data_version`created_at`source_watermark_id`record_hash,
        [SYMBOL, INT, STRING, SYMBOL, SYMBOL, SYMBOL, STRING, SYMBOL, SYMBOL, SYMBOL, INT, SYMBOL, STRING, SYMBOL, SYMBOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorRegistry, tableName=`factor_registry,
        partitionColumns=`created_at, sortColumns=`factor_id`factor_version`created_at)
}

if (!existsTable(targetDatabase, `factor_observation_clean)) {
    factorObservationClean = table(1:0,
        `signal_date`ts_code`factor_id`factor_version`value`observation_date`available_date`report_period`stale_days`dedup_resolution`source_revision_id`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, SYMBOL, INT, DOUBLE, DATE, DATE, DATE, INT, SYMBOL, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorObservationClean, tableName=`factor_observation_clean,
        partitionColumns=`signal_date, sortColumns=`factor_id`ts_code`signal_date)
}

if (!existsTable(targetDatabase, `factor_quarantine)) {
    factorQuarantine = table(1:0,
        `observation_date`ts_code`factor_id`factor_version`reason`source_row_ids_json`distinct_values_json`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, SYMBOL, INT, SYMBOL, STRING, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorQuarantine, tableName=`factor_quarantine,
        partitionColumns=`observation_date, sortColumns=`factor_id`ts_code`observation_date)
}

if (!existsTable(targetDatabase, `factor_quality_snapshot)) {
    factorQualitySnapshot = table(1:0,
        `as_of_date`factor_id`factor_version`scope_id`eligibility_status`metrics_json`rules_version`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, INT, STRING, SYMBOL, STRING, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorQualitySnapshot, tableName=`factor_quality_snapshot,
        partitionColumns=`as_of_date, sortColumns=`factor_id`factor_version`as_of_date)
}

if (!existsTable(targetDatabase, `factor_similarity)) {
    factorSimilarity = table(1:0,
        `as_of_date`scope_id`factor_id_left`factor_id_right`median_daily_abs_spearman`valid_days`status`cluster_id`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, STRING, SYMBOL, SYMBOL, DOUBLE, INT, SYMBOL, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorSimilarity, tableName=`factor_similarity,
        partitionColumns=`as_of_date, sortColumns=`factor_id_left`factor_id_right`as_of_date)
}

if (!existsTable(targetDatabase, `factor_set)) {
    factorSet = table(1:0,
        `factor_set_id`selection_scope_id`rules_version`member_count`status`content_hash`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, STRING, INT, INT, SYMBOL, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorSet, tableName=`factor_set,
        partitionColumns=`created_at, sortColumns=`factor_set_id`rules_version`created_at)
}

if (!existsTable(targetDatabase, `factor_set_member)) {
    factorSetMember = table(1:0,
        `factor_set_id`factor_id`factor_version`feature_order`frozen_direction`selection_reason`run_id`data_version`created_at`source_watermark_id`record_hash,
        [STRING, SYMBOL, INT, INT, INT, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorSetMember, tableName=`factor_set_member,
        partitionColumns=`created_at, sortColumns=`factor_set_id`factor_id`factor_version`created_at)
}

if (!existsTable(targetDatabase, `label_daily)) {
    labelDaily = table(1:0,
        `signal_date`ts_code`label_id`label_version`entry_date`exit_date`label_available_date`raw_return`rank_pct`winsorized_return`zscore_return`neutral_residual`label_valid`invalid_reason`entry_realized_tradable`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, SYMBOL, INT, DATE, DATE, DATE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, BOOL, SYMBOL, BOOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=labelDaily, tableName=`label_daily,
        partitionColumns=`signal_date, sortColumns=`ts_code`label_id`label_version`signal_date)
}
