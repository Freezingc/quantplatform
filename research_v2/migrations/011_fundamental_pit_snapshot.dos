// targetDatabase is injected by the V2 migration runner.
db = database(targetDatabase)

if (!existsTable(targetDatabase, `fundamental_pit_snapshot)) {
    fundamentalPitSnapshot = table(1:0,
        `signal_date`ts_code`metric_id`value`report_period`ann_date`available_date`source_revision_id`stale_days`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, SYMBOL, DOUBLE, DATE, DATE, DATE, STRING, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=fundamentalPitSnapshot, tableName=`fundamental_pit_snapshot,
        partitionColumns=`signal_date, sortColumns=`metric_id`ts_code`signal_date)
}
