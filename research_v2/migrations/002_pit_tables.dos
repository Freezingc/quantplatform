// targetDatabase is injected by the V2 migration runner.
db = database(targetDatabase)

if (!existsTable(targetDatabase, `security_master_scd)) {
    securityMasterScd = table(1:0,
        `ts_code`exchange`board`list_date`delist_date`security_name`is_st`listing_status`valid_from`valid_to`run_id`data_version`created_at`source_watermark_id`record_hash,
        [SYMBOL, SYMBOL, SYMBOL, DATE, DATE, STRING, BOOL, SYMBOL, DATE, DATE, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=securityMasterScd, tableName=`security_master_scd,
        partitionColumns=`valid_from, sortColumns=`ts_code`valid_from)
}

if (!existsTable(targetDatabase, `market_daily_clean)) {
    marketDailyClean = table(1:0,
        `trade_date`ts_code`raw_open`raw_high`raw_low`raw_close`volume`amount`adj_factor`adjusted_open`valid_trade_day`valid_days_20`adv20`listing_age_trading_days`source_flags`dedup_resolution`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, LONG, DOUBLE, DOUBLE, DOUBLE, BOOL, INT, DOUBLE, INT, STRING, SYMBOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=marketDailyClean, tableName=`market_daily_clean,
        partitionColumns=`trade_date, sortColumns=`ts_code`trade_date)
}

if (!existsTable(targetDatabase, `tradability_daily)) {
    tradabilityDaily = table(1:0,
        `trade_date`ts_code`is_st`is_suspended`is_listed`listing_age_trading_days`valid_days_20`adv20`is_eligible_pre_liquidity`reason_bitmap`rule_version`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, BOOL, BOOL, BOOL, INT, INT, DOUBLE, BOOL, LONG, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=tradabilityDaily, tableName=`tradability_daily,
        partitionColumns=`trade_date, sortColumns=`ts_code`trade_date)
}

if (!existsTable(targetDatabase, `universe_definition)) {
    universeDefinition = table(1:0,
        `universe_id`universe_version`rules_json`rules_hash`status`run_id`data_version`created_at`source_watermark_id`record_hash,
        [SYMBOL, INT, STRING, STRING, SYMBOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=universeDefinition, tableName=`universe_definition,
        partitionColumns=`created_at, sortColumns=`universe_id`universe_version`created_at)
}

if (!existsTable(targetDatabase, `universe_daily)) {
    universeDaily = table(1:0,
        `signal_date`universe_id`universe_version`ts_code`is_member`exclusion_reason`reason_bitmap`adv20_rank`membership_rank`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, INT, SYMBOL, BOOL, SYMBOL, LONG, INT, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=universeDaily, tableName=`universe_daily,
        partitionColumns=`signal_date, sortColumns=`universe_id`universe_version`ts_code`signal_date)
}
