// targetDatabase is injected by the V2 migration runner.
db = database(targetDatabase)

if (!existsTable(targetDatabase, `factor_rank_ic_daily)) {
    factorRankIcDaily = table(1:0,
        `signal_date`factor_id`factor_version`factor_name`rank_ic`sample_count`evaluation_scope`label_id`label_version`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, INT, STRING, DOUBLE, LONG, STRING, SYMBOL, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorRankIcDaily, tableName=`factor_rank_ic_daily,
        partitionColumns=`signal_date, sortColumns=`factor_id`factor_version`signal_date)
}

if (!existsTable(targetDatabase, `factor_rank_ic_summary)) {
    factorRankIcSummary = table(1:0,
        `as_of_date`factor_id`factor_version`factor_name`evaluation_scope`valid_day_count`mean_rank_ic`rank_ic_std`icir`positive_day_share`mean_sample_count`label_id`label_version`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, INT, STRING, STRING, INT, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, SYMBOL, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorRankIcSummary, tableName=`factor_rank_ic_summary,
        partitionColumns=`as_of_date, sortColumns=`factor_id`factor_version`as_of_date)
}
