// targetDatabase is injected by the V2 migration runner.
db = database(targetDatabase)

if (!existsTable(targetDatabase, `latest_manifest)) {
    latestManifest = table(1:0,
        `object_name`logical_partition`batch_id`source_object`source_data_version`published_at`row_count`business_hash`status,
        [SYMBOL, STRING, LONG, SYMBOL, STRING, TIMESTAMP, LONG, STRING, SYMBOL])
    db.createPartitionedTable(table=latestManifest, tableName=`latest_manifest,
        partitionColumns=`published_at, sortColumns=`object_name`logical_partition`published_at)
}

if (!existsTable(targetDatabase, `tradability_daily_latest)) {
    tradabilityLatest = table(1:0,
        `batch_id`trade_date`ts_code`is_st`is_suspended`is_listed`listing_age_trading_days`valid_days_20`adv20`is_eligible_pre_liquidity`reason_bitmap`rule_version,
        [LONG, DATE, SYMBOL, BOOL, BOOL, BOOL, INT, INT, DOUBLE, BOOL, LONG, INT])
    db.createPartitionedTable(table=tradabilityLatest, tableName=`tradability_daily_latest,
        partitionColumns=`trade_date, sortColumns=`ts_code`trade_date)
}

if (!existsTable(targetDatabase, `universe_daily_latest)) {
    universeLatest = table(1:0,
        `batch_id`signal_date`universe_id`universe_version`ts_code`is_member`exclusion_reason`reason_bitmap`adv20_rank`membership_rank,
        [LONG, DATE, SYMBOL, INT, SYMBOL, BOOL, SYMBOL, LONG, INT, INT])
    db.createPartitionedTable(table=universeLatest, tableName=`universe_daily_latest,
        partitionColumns=`signal_date, sortColumns=`universe_id`universe_version`ts_code`signal_date)
}

if (!existsTable(targetDatabase, `label_daily_latest)) {
    labelLatest = table(1:0,
        `batch_id`signal_date`ts_code`label_id`label_version`entry_date`exit_date`label_available_date`raw_return`rank_pct`winsorized_return`zscore_return`neutral_residual`label_valid`invalid_reason`entry_realized_tradable,
        [LONG, DATE, SYMBOL, SYMBOL, INT, DATE, DATE, DATE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, BOOL, SYMBOL, BOOL])
    db.createPartitionedTable(table=labelLatest, tableName=`label_daily_latest,
        partitionColumns=`signal_date, sortColumns=`ts_code`label_id`label_version`signal_date)
}

if (!existsTable(targetDatabase, `factor_observation_clean_latest)) {
    factorObservationLatest = table(1:0,
        `batch_id`signal_date`ts_code`factor_id`factor_version`value`observation_date`available_date`report_period`stale_days`dedup_resolution`source_revision_id,
        [LONG, DATE, SYMBOL, SYMBOL, INT, DOUBLE, DATE, DATE, DATE, INT, SYMBOL, STRING])
    db.createPartitionedTable(table=factorObservationLatest, tableName=`factor_observation_clean_latest,
        partitionColumns=`signal_date, sortColumns=`factor_id`ts_code`signal_date)
}
