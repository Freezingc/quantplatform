// targetDatabase is injected by the V2 migration runner.
db = database(targetDatabase)

if (!existsTable(targetDatabase, `factor_repair_audit)) {
    factorRepairAudit = table(1:0,
        `as_of_date`logical_partition`factor_id`factor_version`source_table`source_factor_name`repair_method`source_rows`candidate_rows`exact_duplicate_groups`exact_duplicate_rows`conflict_groups`nonfinite_rows`overlap_finite_rows`fillable_rows`filled_rows`added_rows`remaining_nonfinite_rows`mismatch_rows`max_abs_diff`max_rel_diff`pit_violation_rows`unresolved_rows`decision_status`rules_version`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, STRING, SYMBOL, INT, SYMBOL, STRING, SYMBOL, LONG, LONG, LONG, LONG, LONG, LONG, LONG, LONG, LONG, LONG, LONG, LONG, DOUBLE, DOUBLE, LONG, LONG, SYMBOL, INT, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorRepairAudit, tableName=`factor_repair_audit,
        partitionColumns=`as_of_date, sortColumns=`factor_id`logical_partition`as_of_date)
}

if (!existsTable(targetDatabase, `factor_repair_quarantine)) {
    factorRepairQuarantine = table(1:0,
        `observation_date`ts_code`factor_id`factor_version`factor_name`reason`source_value`candidate_value`repair_method`candidate_hash`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, SYMBOL, INT, STRING, SYMBOL, DOUBLE, DOUBLE, SYMBOL, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=factorRepairQuarantine, tableName=`factor_repair_quarantine,
        partitionColumns=`observation_date, sortColumns=`factor_id`ts_code`reason`observation_date)
