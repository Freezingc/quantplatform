// targetDatabase is injected by the V2 migration runner.
if (!existsDatabase(targetDatabase)) {
    database(targetDatabase, VALUE, 2013.01M..2030.12M, engine="TSDB")
}

db = database(targetDatabase)

if (!existsTable(targetDatabase, `schema_migration)) {
    schemaMigration = table(1:0,
        `schema_version`name`checksum`applied_at`applied_by`run_id`data_version`created_at`source_watermark_id`record_hash,
        [INT, STRING, STRING, TIMESTAMP, SYMBOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=schemaMigration, tableName=`schema_migration,
        partitionColumns=`applied_at, sortColumns=`applied_at`schema_version)
}

if (!existsTable(targetDatabase, `migration_lock)) {
    migrationLock = table(1:0,
        `lock_name`owner_run_id`acquired_at`expires_at,
        [SYMBOL, UUID, TIMESTAMP, TIMESTAMP])
    db.createPartitionedTable(table=migrationLock, tableName=`migration_lock,
        partitionColumns=`acquired_at, sortColumns=`lock_name`acquired_at)
}

if (!existsTable(targetDatabase, `published_version)) {
    publishedVersion = table(1:0,
        `object_name`logical_partition`data_version`previous_data_version`published_at`run_id,
        [SYMBOL, STRING, STRING, STRING, TIMESTAMP, UUID])
    db.createPartitionedTable(table=publishedVersion, tableName=`published_version,
        partitionColumns=`published_at, sortColumns=`object_name`published_at)
}

if (!existsTable(targetDatabase, `pipeline_run)) {
    pipelineRun = table(1:0,
        `run_id`pipeline_name`status`data_version`config_hash`code_commit`started_at`finished_at`error_class`error_message`environment_json`created_at`source_watermark_id`record_hash,
        [UUID, SYMBOL, SYMBOL, STRING, STRING, STRING, TIMESTAMP, TIMESTAMP, SYMBOL, STRING, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=pipelineRun, tableName=`pipeline_run,
        partitionColumns=`started_at, sortColumns=`pipeline_name`started_at)
}

if (!existsTable(targetDatabase, `source_watermark)) {
    sourceWatermark = table(1:0,
        `source_watermark_id`source_name`table_name`max_observation_date`source_row_count`schema_fingerprint`captured_at`run_id,
        [STRING, SYMBOL, SYMBOL, DATE, LONG, STRING, TIMESTAMP, UUID])
    db.createPartitionedTable(table=sourceWatermark, tableName=`source_watermark,
        partitionColumns=`captured_at, sortColumns=`source_name`table_name`captured_at)
}

if (!existsTable(targetDatabase, `data_quality_result)) {
    dataQualityResult = table(1:0,
        `run_id`object_name`check_name`scope_name`severity`status`observed_value`expected_rule`sample_json`created_at,
        [UUID, SYMBOL, SYMBOL, STRING, SYMBOL, SYMBOL, STRING, STRING, STRING, TIMESTAMP])
    db.createPartitionedTable(table=dataQualityResult, tableName=`data_quality_result,
        partitionColumns=`created_at, sortColumns=`object_name`check_name`created_at)
}

if (!existsTable(targetDatabase, `source_reconciliation)) {
    sourceReconciliation = table(1:0,
        `trade_date`ts_code`field_name`check_version`primary_value`secondary_value`abs_diff`rel_diff`status`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, SYMBOL, INT, STRING, STRING, DOUBLE, DOUBLE, SYMBOL, UUID, STRING, TIMESTAMP, STRING, STRING])
    db.createPartitionedTable(table=sourceReconciliation, tableName=`source_reconciliation,
        partitionColumns=`trade_date, sortColumns=`ts_code`field_name`trade_date)
}
