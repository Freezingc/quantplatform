db = database(targetDatabase)

if (!existsTable(targetDatabase, `market_quarantine)) {
    marketQuarantine = table(1:0,
        `trade_date`ts_code`field_name`reason`raw_value`run_id`data_version`created_at`source_watermark_id`record_hash,
        [DATE, SYMBOL, SYMBOL, SYMBOL, STRING, UUID, STRING, TIMESTAMP, STRING, STRING])
